// cap resource limits based on demo bioshell flavour with leeway for the nf head job
process {
    resourceLimits = [
        cpus: 3,
        memory: '12.GB',
    ]
}

params {
    config_profile_name        = 'BioShell test profile'
    config_profile_description = 'nf-core/scrnaseq test dataset (Sample_X/Sample_Y, mouse chr19), downloaded locally to keep the demo self-contained'

    // Input data
    input           = 'samplesheet.csv'
    aligner         = 'star'
    protocol        = '10XV2'
    skip_cellbender = true // module does not work on small dataset
    skip_qcatch     = true // module does not work on small dataset

    // Genome references
    fasta = 'data/GRCm38.p6.genome.chr19.fa'
    gtf   = 'data/gencode.vM19.annotation.chr19.gtf'

    validationSchemaIgnoreParams = 'genomes'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/mnt/data/.singularity_cache'
}

// CVMFS-mirrored Biocontainers for this run — zero download, zero duplicate storage.
// Everything else (MULTIQC, MTX_TO_H5AD, CELLBENDER, ANNDATAR_CONVERT, ...) has no
// CVMFS mirror and downloads normally.
process {
    withName: 'FASTQC'          { container = '/cvmfs/singularity.galaxyproject.org/all/fastqc:0.12.1--hdfd78af_0' }
    withName: 'GTF_GENE_FILTER' { container = '/cvmfs/singularity.galaxyproject.org/all/python:3.9--1' }
    withName: 'STAR_ALIGN'      { container = '/cvmfs/singularity.galaxyproject.org/all/star:2.7.10b--h9ee0642_0' }
}
